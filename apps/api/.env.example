# API Tank Construction — secrets côté serveur uniquement (jamais exposés au front).
# Copier vers .env et renseigner. Ne jamais committer .env.

# PostgreSQL (Supabase à venir). Timezone base : Africa/Douala.
DATABASE_URL="postgresql://user:password@localhost:5432/tank?schema=public"

PORT=3000

