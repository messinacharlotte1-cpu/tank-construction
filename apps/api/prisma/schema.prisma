// Schéma data model Tank Construction — noyau P0 (cf. README-dev.md §5, CLAUDE.md).
// RÈGLES : tenant_id partout + RLS PostgreSQL (à activer en migration SQL).
//          Montants = entiers FCFA (BigInt), jamais de flottants.
//          Documents émis = snapshot des taux/totaux à l'émission (champ Json), jamais recalculés.
//          Audit append-only. Timezone base : Africa/Douala (dates ISO).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  nom       String
  createdAt DateTime @default(now())

  users             User[]
  chantiers         Chantier[]
  devis             Devis[]
  factures          Facture[]
  articles          Article[]
  programmes        Programme[]
  contrats          Contrat[]
  fournisseurs      Fournisseur[]
  sousTraitants     SousTraitant[]
  materiels         Materiel[]
  incidents         Incident[]
  settings          Setting[]
  bpuOuvrages       BpuOuvrage[]
  messages          Message[]
  situations        Situation[]
  reserves          Reserve[]
  medias            Media[]
  auditLogs         AuditLog[]
  securiteChecklist SecuriteChecklist[]
  corpsEtats        CorpsEtat[]

  @@map("tenants")
}

enum Role {
  SUPER_ADMIN
  DIRECTION
  CONDUCTEUR
  CHEF_CHANTIER
  COMPTA
  COMMERCIAL
  TERRAIN
  ACQUEREUR
  MO // Maître d'ouvrage (client BTP d'un chantier) — accès portail scopé
}

enum AccesMode {
  EMAIL_2FA
  PIN
}

model User {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  email     String
  nom       String
  telephone String? // coordonnées client (portail)
  adresse   String? // coordonnées client (portail)
  role      Role      @default(TERRAIN)
  acces     AccesMode @default(EMAIL_2FA)
  actif     Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum StatutChantier {
  EN_PREPARATION
  EN_COURS
  EN_RETARD
  SUSPENDU
  TERMINE
}

// Périmètre d'exécution d'un chantier (corps d'état pris en charge).
// Utile au suivi quand le marché se limite à l'un des deux (ou est mixte).
enum PerimetreChantier {
  GO // gros œuvre seul
  SO // second œuvre seul
  MIXTE // les deux
}

// Catégorie de corps d'état — split racine, fixe (2 valeurs).
enum CategorieCorpsEtat {
  GROS_OEUVRE
  SECOND_OEUVRE
}

// Taxonomie corps d'état réutilisable (Gros/Second œuvre + poste/ouvrage).
// Référencée par les tâches, les réserves et les lots DQE. Extensible sans migration
// d'enum : les postes (Terrassement, Fondations, Plomberie…) sont des lignes, pas un enum.
model CorpsEtat {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  categorie CategorieCorpsEtat
  libelle   String // "Terrassement", "Fondations", "Élévation", "Plomberie"…
  ordre     Int                @default(0)
  actif     Boolean            @default(true)
  createdAt DateTime           @default(now())

  taches   Tache[]
  reserves Reserve[]
  lots     Lot[]

  @@unique([tenantId, categorie, libelle])
  @@index([tenantId])
  @@map("corps_etat")
}

model Chantier {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  nom             String
  client          String
  userId          String? // compte maître d'ouvrage rattaché (auth.uid) — accès portail scopé
  ville           String
  statut          StatutChantier     @default(EN_PREPARATION)
  perimetre       PerimetreChantier? // GO | SO | MIXTE — corps d'état pris en charge
  budget          BigInt // FCFA
  consomme        BigInt             @default(0) // FCFA
  debut           DateTime?
  fin             DateTime?
  avancementPrevu Int                @default(0)
  avancementReel  Int                @default(0)
  createdAt       DateTime           @default(now())

  taches    Tache[]
  jalons    Jalon[]
  pointages Pointage[]
  journal   JournalChantier[]
  reserves  Reserve[]
  medias    Media[]
  devis     Devis[]
  articles  Article[]

  @@index([tenantId])
  @@index([userId])
  @@map("chantiers")
}

// Checklist sécurité journalière — signée chaque matin par le chef de chantier (offline).
model SecuriteChecklist {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  item      String
  ok        Boolean  @default(false)
  ordre     Int      @default(0)
  updatedAt DateTime @default(now())

  @@index([tenantId])
  @@map("securite_checklist")
}

// Journal de chantier — rapports terrain (saisis offline, météo horodatée = justificatif contractuel).
model JournalChantier {
  id         String   @id @default(uuid())
  chantierId String
  chantier   Chantier @relation(fields: [chantierId], references: [id])
  date       DateTime @default(now())
  auteur     String
  meteo      String?
  texte      String
  photos     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([chantierId, date])
  @@map("journal_chantier")
}

model Tache {
  id          String     @id @default(uuid())
  chantierId  String
  chantier    Chantier   @relation(fields: [chantierId], references: [id])
  nom         String
  lot         String // activité/lot de travaux (texte libre existant)
  corpsEtatId String? // corps d'état de rattachement (Gros/Second œuvre + poste)
  corpsEtat   CorpsEtat? @relation(fields: [corpsEtatId], references: [id])
  pct         Int        @default(0)
  debut       DateTime?
  duree       Int? // jours (Gantt)
  dependance  String?

  @@index([chantierId])
  @@index([corpsEtatId])
  @@map("taches")
}

// Jalon = déclencheur d'appel de fonds VEFA (constat contradictoire requis avant émission).
model Jalon {
  id         String         @id @default(uuid())
  chantierId String
  chantier   Chantier       @relation(fields: [chantierId], references: [id])
  libelle    String
  valide     Boolean        @default(false)
  valideLe   DateTime?
  appels     AppelDeFonds[]

  @@index([chantierId])
  @@map("jalons")
}

enum StatutPointage {
  P // présent
  DM // demi-journée
  A // absent
}

model Pointage {
  id         String         @id @default(uuid())
  chantierId String
  chantier   Chantier       @relation(fields: [chantierId], references: [id])
  ouvrier    String
  tarif      Int            @default(0) // FCFA/jour pour calcul paie du jour
  date       DateTime
  statut     StatutPointage
  // Offline-first : idempotence via uuid client (dernier écrit gagne + audit).
  clientUuid String?        @unique

  @@index([chantierId, date])
  @@map("pointages")
}

model Devis {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  numero     String // préfixe paramétrable DEV-, séquence par exercice
  client     String
  chantierId String? // chantier rattaché — rend le devis visible dans le volet du chantier
  chantier   Chantier? @relation(fields: [chantierId], references: [id])
  statut     String    @default("Brouillon")
  remisePct  Float     @default(0) // remise appliquée sur le total HT (avant TVA)
  // Snapshot à l'émission : taux (TVA) + totaux figés en JSON. Jamais recalculés.
  snapshot   Json?
  createdAt  DateTime  @default(now())

  lots Lot[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@index([chantierId])
  @@map("devis")
}

model Lot {
  id          String     @id @default(uuid())
  devisId     String
  devis       Devis      @relation(fields: [devisId], references: [id])
  nom         String
  corpsEtatId String? // rattache le lot DQE à la taxonomie (au lieu du nom libre)
  corpsEtat   CorpsEtat? @relation(fields: [corpsEtatId], references: [id])
  ordre       Int        @default(0)

  sousOuvrages SousOuvrage[]

  @@index([devisId])
  @@index([corpsEtatId])
  @@map("lots")
}

// Niveau intermédiaire DQE : Lot → Sous-ouvrage → Ligne.
model SousOuvrage {
  id    String @id @default(uuid())
  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id])
  nom   String
  ordre Int    @default(0)

  lignes Ligne[]

  @@index([lotId])
  @@map("sous_ouvrages")
}

// Unités valides : u, m², m³, kg, ml, ff, pm, ens, mois. `pm` = pour mémoire (jamais chiffré).
model Ligne {
  id            String      @id @default(uuid())
  sousOuvrageId String
  sousOuvrage   SousOuvrage @relation(fields: [sousOuvrageId], references: [id])
  designation   String
  unite         String
  quantite      Float
  prixUnitaire  BigInt // FCFA
  ordre         Int         @default(0)

  @@index([sousOuvrageId])
  @@map("lignes")
}

// Situation de travaux : avancement cumulé + retenue de garantie 10 %.
model Situation {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  chantier   String
  numero     String
  cumulPct   Float    @default(0)
  montantHT  BigInt   @default(0) // FCFA, montant travaux cumulé HT
  retenuePct Float    @default(10)
  statut     String   @default("Brouillon")
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@map("situations")
}

enum ModePaiement {
  MOMO
  OM
  VIREMENT
  ESPECES
}

model Facture {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  numero    String // FAC-
  client    String
  ttc       BigInt // FCFA
  statut    String   @default("Brouillon")
  snapshot  Json?
  createdAt DateTime @default(now())

  paiements Paiement[]

  @@unique([tenantId, numero])
  @@index([tenantId])
  @@map("factures")
}

model Paiement {
  id             String       @id @default(uuid())
  factureId      String
  facture        Facture      @relation(fields: [factureId], references: [id])
  montant        BigInt // FCFA
  mode           ModePaiement
  refTransaction String?
  date           DateTime     @default(now())

  @@index([factureId])
  @@map("paiements")
}

model Article {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  chantierId  String? // projet de rattachement du stock (magasin par chantier)
  chantier    Chantier? @relation(fields: [chantierId], references: [id])
  designation String
  unite       String
  stock       Float     @default(0)
  seuil       Float     @default(0)

  mouvements MouvementStock[]

  @@index([tenantId])
  @@index([chantierId])
  @@map("articles")
}

enum TypeMouvement {
  ENTREE
  SORTIE
  RETOUR // retour magasin d'un matériau résiduel (réutilisable)
}

model MouvementStock {
  id        String        @id @default(uuid())
  articleId String
  article   Article       @relation(fields: [articleId], references: [id])
  type      TypeMouvement
  quantite  Float
  motif     String?
  // Résiduels (type RETOUR) : caractéristiques du reste réutilisable (poids/longueur/surface…).
  caracteristiques Json?
  date      DateTime      @default(now())

  @@index([articleId, date])
  @@map("mouvements_stock")
}

// ── Ressources ────────────────────────────────────────────
model Fournisseur {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nom       String
  categorie String? // Matériaux, Location, Services…
  contact   String?
  telephone String?
  note      Int      @default(0) // évaluation 0..5 (étoiles)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("fournisseurs")
}

model SousTraitant {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  nom                String
  corpsEtat          String // maçonnerie, électricité…
  chantier           String?
  montantMarche      BigInt   @default(0) // FCFA
  retenueGarantiePct Float    @default(5)
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@map("sous_traitants")
}

enum StatutMateriel {
  DISPONIBLE
  EN_SERVICE
  MAINTENANCE
}

model Materiel {
  id                String         @id @default(uuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  nom               String
  type              String? // engin, véhicule, outillage
  statut            StatutMateriel @default(DISPONIBLE)
  prochainEntretien DateTime?
  createdAt         DateTime       @default(now())

  @@index([tenantId])
  @@map("materiels")
}

enum GraviteIncident {
  MINEUR
  MAJEUR
  CRITIQUE
}

model Incident {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  chantier    String?
  date        DateTime        @default(now())
  gravite     GraviteIncident @default(MINEUR)
  description String
  mesure      String? // mesure corrective
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@map("incidents")
}

// Paramètres versionnés par tenant (taux TVA/CNPS, préfixes numérotation…). Changement ne réécrit jamais un document émis.
model Setting {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  cle      String
  valeur   String

  @@unique([tenantId, cle])
  @@index([tenantId])
  @@map("settings")
}

// Réserves / OPR (opérations préalables à la réception).
model Reserve {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  chantier     String // nom du chantier (dénormalisé, conservé le temps de basculer sur la FK)
  chantierId   String? // vrai lien chantier (backfill depuis le nom)
  chantierRef  Chantier?  @relation(fields: [chantierId], references: [id])
  corpsEtatId  String? // corps d'état + poste sur lequel la réserve est émise
  corpsEtat    CorpsEtat? @relation(fields: [corpsEtatId], references: [id])
  localisation String?
  description  String
  entreprise   String?
  statut       String     @default("Ouverte") // Ouverte | Levée
  echeance     DateTime?
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@index([chantierId])
  @@index([corpsEtatId])
  @@map("reserves")
}

// Catégorie de média : distingue photos, plans et actes administratifs (permis, certif urbanisme…).
enum CategorieMedia {
  PHOTO
  PLAN
  ACTE_ADMIN
}

// Médias (plans/photos/actes admin) + annotations épinglées (x,y) stockées en JSON.
model Media {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  chantier    String // nom du chantier (dénormalisé, conservé le temps de basculer sur la FK)
  chantierId  String? // vrai lien chantier (backfill depuis le nom)
  chantierRef Chantier?      @relation(fields: [chantierId], references: [id])
  categorie   CategorieMedia @default(PHOTO)
  nom         String
  url         String // URL publique Supabase Storage (bucket `medias`)
  annotations Json? // [{ x, y, note, resolu }]
  createdAt   DateTime       @default(now())

  @@index([tenantId])
  @@index([chantierId])
  @@map("medias")
}

// Bibliothèque de prix (BPU) — base Yaoundé, coefficients régionaux appliqués côté app.
model BpuOuvrage {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  code        String
  designation String
  unite       String
  puBase      BigInt // FCFA, base Yaoundé
  categorie   String?

  @@index([tenantId])
  @@map("bpu_ouvrages")
}

// Messagerie interne (fil simple).
model Message {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  auteur    String
  contenu   String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("messages")
}

// Audit append-only (aucun UPDATE/DELETE applicatif), 12 mois mini.
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  acteur    String
  action    String
  cible     String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// ── Promotion immobilière ─────────────────────────────────
model Programme {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nom       String
  ville     String
  public    Boolean  @default(false) // visible sur la vitrine publique (lecture anon)
  createdAt DateTime @default(now())

  lots LotImmo[]

  @@index([tenantId])
  @@map("programmes")
}

enum StatutLotImmo {
  DISPONIBLE
  RESERVE
  VENDU
}

model LotImmo {
  id          String        @id @default(uuid())
  programmeId String
  programme   Programme     @relation(fields: [programmeId], references: [id])
  reference   String
  bloc        String?
  niveau      String?
  typologie   String? // T2, T3, villa…
  surface     Float?
  prix        BigInt // FCFA
  statut      StatutLotImmo @default(DISPONIBLE)

  reservations Reservation[]

  @@index([programmeId])
  @@map("lots_immo")
}

model Reservation {
  id        String   @id @default(uuid())
  lotImmoId String
  lotImmo   LotImmo  @relation(fields: [lotImmoId], references: [id])
  acquereur String
  userId    String? // compte acquéreur rattaché (auth.uid) — accès portail scopé
  date      DateTime @default(now())

  appels AppelDeFonds[]

  @@index([lotImmoId])
  @@index([userId])
  @@map("reservations")
}

enum StatutAppel {
  PREVU
  EMIS
  PAYE
}

// Contrats (droit CM) — modèle indicatif tant que non validé notaire (cf. CLAUDE.md règle 10).
// Signature électronique = OTP + horodatage + empreinte (hash) consignés dans otpLog.
model Contrat {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  reference       String
  type            String // VEFA | CONSTRUCTION | RESERVATION
  client          String
  objet           String?
  montant         BigInt   @default(0) // FCFA
  templateVersion String   @default("v0-indicatif")
  statutSignature String   @default("Projet") // Projet | En attente OTP | Signé
  otpLog          Json?
  reservationId   String?
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@map("contrats")
}

// VEFA : un appel de fonds n'est émissible que si son jalon chantier est validé (constat contradictoire).
model AppelDeFonds {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  jalonId       String?
  jalon         Jalon?      @relation(fields: [jalonId], references: [id])
  libelle       String
  montant       BigInt // FCFA
  echeance      DateTime?
  statut        StatutAppel @default(PREVU)

  @@index([reservationId])
  @@map("appels_de_fonds")
}

// Portail client — fil d'échange client ↔ équipe commerciale (avec pièce jointe optionnelle).
model ClientMessage {
  id        String   @id @default(uuid())
  userId    String // auth.uid du client (fil rattaché au compte)
  tenantId  String // agence destinataire (scope staff)
  auteur    String // "client" | "agence"
  nom       String // nom affiché de l'auteur
  sujet     String?
  corps     String
  pieceUrl  String?
  pieceNom  String?
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@map("client_messages")
}
